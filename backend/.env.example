# SkillOra Backend Environment Configuration

# Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACKS=gemini-flash-latest,gemini-3.5-flash

# Optional: Avoid GitHub API rate limits
GITHUB_TOKEN=

# Set USE_LLM=0 to force deterministic rule-based fallback (no Gemini calls)
USE_LLM=1

# Database Configuration:
# - PostgreSQL via Docker Compose (Port 5433):
DB_URL=postgresql+psycopg://skillora:skillora_dev_pw@localhost:5433/skillora
# - Or leave unset for local SQLite fallback:
# DB_URL=sqlite:///./skillora.db

# JWT Secret for session authentication (change in production)
JWT_SECRET=skillora-development-secret-key-change-in-production
